generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String         @id @default(cuid())
    email         String         @unique
    password      String
    name          String
    businessName  String?
    phone         String?
    logoUrl       String?
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    clients       Client[]
    invoices      Invoice[]
    refreshTokens RefreshToken[]
}

model RefreshToken {
    id        String   @id @default(cuid())
    token     String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    createdAt DateTime @default(now())
}

model Client {
    id        String    @id @default(cuid())
    name      String
    email     String
    phone     String?
    address   String?
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    invoices  Invoice[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model Invoice {
    id                String             @id @default(cuid())
    invoiceNumber     String             @unique
    title             String
    userId            String
    clientId          String
    status            InvoiceStatus      @default(DRAFT)
    dueDate           DateTime
    issueDate         DateTime           @default(now())
    currency          String             @default("NGN")
    subtotal          Decimal            @db.Decimal(12, 2)
    tax               Decimal            @default(0) @db.Decimal(12, 2)
    total             Decimal            @db.Decimal(12, 2)
    notes             String?
    paystackRef       String?
    sentAt            DateTime?
    paidAt            DateTime?
    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    client            Client             @relation(fields: [clientId], references: [id])
    items             InvoiceItem[]
    payments          Payment[]
    followUpLogs      FollowUpLog[]
    followUpSchedules FollowUpSchedule[]
    emailOpens        EmailOpen[]
    payLinkClicks     PayLinkClick[]
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}

model InvoiceItem {
    id          String  @id @default(cuid())
    invoiceId   String
    description String
    quantity    Decimal @db.Decimal(10, 2)
    unitPrice   Decimal @db.Decimal(12, 2)
    total       Decimal @db.Decimal(12, 2)
    invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
    id        String   @id @default(cuid())
    invoiceId String
    amount    Decimal  @db.Decimal(12, 2)
    method    String?
    reference String?
    note      String?
    paidAt    DateTime @default(now())
    invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
}

model FollowUpSchedule {
    id          String           @id @default(cuid())
    invoiceId   String
    channel     FollowUpChannel
    template    FollowUpTemplate
    scheduledAt DateTime
    sentAt      DateTime?
    status      FollowUpStatus   @default(PENDING)
    invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    createdAt   DateTime         @default(now())
}

model FollowUpLog {
    id        String            @id @default(cuid())
    invoiceId String
    channel   FollowUpChannel
    template  FollowUpTemplate?
    message   String
    status    String
    sentAt    DateTime          @default(now())
    invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    createdAt DateTime          @default(now())
}

model EmailOpen {
    id        String   @id @default(cuid())
    invoiceId String
    openedAt  DateTime @default(now())
    invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PayLinkClick {
    id        String   @id @default(cuid())
    invoiceId String
    clickedAt DateTime @default(now())
    invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
    DRAFT
    PENDING
    PARTIAL
    PAID
    OVERDUE
    CANCELLED
}

enum FollowUpChannel {
    EMAIL
    WHATSAPP
}

enum FollowUpStatus {
    PENDING
    SENT
    FAILED
    CANCELLED
    PAUSED
}

enum FollowUpTemplate {
    INVOICE_SENT
    PRE_DUE_REMINDER
    FIRST_OVERDUE
    SECOND_OVERDUE
    FINAL_NOTICE
}
